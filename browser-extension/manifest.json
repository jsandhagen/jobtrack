{
  "manifest_version": 3,
  "name": "Sprout — Job Application Buddy",
  "short_name": "Sprout",
  "version": "0.1.0",
  "description": "Sends the job posting you're viewing to the Sprout desktop app for a fit score and a tailored resume.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Send this job to Sprout", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "send-to-sprout": { "suggested_key": { "default": "Alt+Shift+J" }, "description": "Send this page's job posting to Sprout" }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.indeed.co.uk/*",
        "*://*.indeed.ca/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*",
        "*://*.glassdoor.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.wellfound.com/*",
        "*://*.bamboohr.com/*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
